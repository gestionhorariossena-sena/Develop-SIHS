#!/usr/bin/env bash

set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
backend_pid=""
frontend_pid=""

cleanup() {
  echo
  echo "Deteniendo servicios..."
  [[ -n "$frontend_pid" ]] && kill "$frontend_pid" 2>/dev/null || true
  [[ -n "$backend_pid" ]] && kill "$backend_pid" 2>/dev/null || true
  wait 2>/dev/null || true
}

trap cleanup EXIT INT TERM

echo "Iniciando backend en http://127.0.0.1:8000/docs"
(
  cd "$project_dir/backend"
  # Ejecutar como módulo evita el shebang con la ruta antigua cuando el
  # repositorio se ha movido de carpeta.
  exec .venv/bin/python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000
) &
backend_pid=$!

echo "Iniciando frontend en http://localhost:5173"
(
  cd "$project_dir/frontend"
  exec npm run dev -- --host 127.0.0.1
) &
frontend_pid=$!

echo "Listo. Presiona Ctrl+C para detener ambos servicios."
wait -n "$backend_pid" "$frontend_pid"
