        <mxCell id="p2_sch" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="&lt;b&gt;solicitud_cambio_horario&lt;/b&gt;&lt;br&gt;&lt;u&gt;idSolicitud&lt;/u&gt; (PK)&lt;br&gt;idInstructor (FK &amp;rarr; usuarios)&lt;br&gt;idHorarioOrigen (FK &amp;rarr; horarios)&lt;br&gt;tipo: novedad|permuta|cambio-ambiente&lt;br&gt;motivo&lt;br&gt;estado: pendiente|aprobada|rechazada&lt;br&gt;fechaSolicitud / fechaResolucion&lt;br&gt;idAdminResolvio (FK &amp;rarr; usuarios)&lt;br&gt;&lt;i&gt;v1: no mueve datos reales al aprobar&lt;/i&gt;" vertex="1">
