        <mxCell id="p2_anot" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;anotaciones_horario&lt;/b&gt;&lt;br&gt;&lt;u&gt;idAnotacion&lt;/u&gt; (PK)&lt;br&gt;idUsuario (FK &amp;rarr; usuarios, CASCADE)&lt;br&gt;idHorario (FK &amp;rarr; horarios, CASCADE, nullable)&lt;br&gt;nota, etiqueta (ej. Normal)&lt;br&gt;recordatorioActivo (bool)&lt;br&gt;fechaCreacion&lt;br&gt;&lt;i&gt;notas personales del aprendiz&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="280" x="1040" y="130" as="geometry" />
