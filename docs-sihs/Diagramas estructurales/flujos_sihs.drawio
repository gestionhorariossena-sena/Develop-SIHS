        <mxCell id="p1_pathA_title" parent="1" style="text;html=1;fontStyle=1;fontSize=13;fontColor=#d79b00;align=left;" value="Camino A &amp;mdash; Solicitud y aprobación de acceso" vertex="1">
          <mxGeometry height="24" width="500" x="40" y="560" as="geometry" />
        </mxCell>
        <mxCell id="p1_a1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" value="1. Solicitante llena el&#xa;formulario público&#xa;&amp;rarr; fila nueva en&#xa;solicitudes_acceso&#xa;(estado=pendiente)" vertex="1">
          <mxGeometry height="110" width="160" x="40" y="600" as="geometry" />
        </mxCell>
        <mxCell id="p1_a2" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" value="2. Admin revisa y&#xa;aprueba &amp;rarr; estado=&#xa;aprobada, se guarda&#xa;idAdminResolvio y&#xa;fechaResolucion" vertex="1">
          <mxGeometry height="110" width="160" x="260" y="600" as="geometry" />
        </mxCell>
        <mxCell id="p1_a3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" value="3. Sistema crea cuenta&#xa;en auth.users (Supabase)&#xa;+ fila en usuarios&#xa;(debeCambiarClave=true,&#xa;clave temporal enviada)" vertex="1">
          <mxGeometry height="110" width="170" x="480" y="600" as="geometry" />
        </mxCell>
        <mxCell id="p1_a4" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" value="4. Sistema inserta en&#xa;usuario_rol el rol que&#xa;se había solicitado" vertex="1">
          <mxGeometry height="110" width="160" x="710" y="600" as="geometry" />
        </mxCell>
        <mxCell id="p1_a5" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" value="5. Si es aprendiz: se&#xa;crea ficha_usuario&#xa;vinculándolo a su&#xa;ficha correspondiente" vertex="1">
          <mxGeometry height="110" width="160" x="930" y="600" as="geometry" />
        </mxCell>
        <mxCell id="p1_aA" edge="1" parent="1" source="p1_a1" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=2;" target="p1_a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_aB" edge="1" parent="1" source="p1_a2" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=2;" target="p1_a3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_aC" edge="1" parent="1" source="p1_a3" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=2;" target="p1_a4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_aD" edge="1" parent="1" source="p1_a4" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=2;" target="p1_a5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_pathB_title" parent="1" style="text;html=1;fontStyle=1;fontSize=13;fontColor=#9673a6;align=left;" value="Camino B &amp;mdash; Login y validación de rol" vertex="1">
          <mxGeometry height="24" width="500" x="40" y="750" as="geometry" />
        </mxCell>
        <mxCell id="p1_b1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" value="1. Usuario envía&#xa;credenciales &amp;rarr;&#xa;Supabase Auth valida&#xa;contra auth.users" vertex="1">
          <mxGeometry height="110" width="160" x="40" y="790" as="geometry" />
        </mxCell>
        <mxCell id="p1_b2" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" value="2. Backend recibe el&#xa;token válido y busca&#xa;el perfil en usuarios&#xa;por idUsuario" vertex="1">
          <mxGeometry height="110" width="160" x="260" y="790" as="geometry" />
        </mxCell>
        <mxCell id="p1_b3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" value="3. Carga usuario_rol&#xa;&amp;rarr; roles para saber&#xa;qué puede hacer&#xa;ese usuario" vertex="1">
          <mxGeometry height="110" width="160" x="480" y="790" as="geometry" />
        </mxCell>
        <mxCell id="p1_b4" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" value="4. Si debeCambiarClave&#xa;=true &amp;rarr; se fuerza&#xa;pantalla de cambio&#xa;de contraseña" vertex="1">
          <mxGeometry height="110" width="160" x="700" y="790" as="geometry" />
        </mxCell>
        <mxCell id="p1_b5" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" value="5. Acceso concedido&#xa;o denegado (403)&#xa;según si el rol&#xa;requerido coincide" vertex="1">
          <mxGeometry height="110" width="160" x="920" y="790" as="geometry" />
        </mxCell>
        <mxCell id="p1_bA" edge="1" parent="1" source="p1_b1" style="endArrow=block;html=1;strokeColor=#9673a6;strokeWidth=2;" target="p1_b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_bB" edge="1" parent="1" source="p1_b2" style="endArrow=block;html=1;strokeColor=#9673a6;strokeWidth=2;" target="p1_b3">
