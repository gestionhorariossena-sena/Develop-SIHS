        <mxCell id="p3_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="p3_asis" target="p3_usr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- ===== CAMINO: Registrar asistencia de una sesión (naranja) ===== -->
        <mxCell id="p3_pathA_title" value="Camino &amp;mdash; Registrar asistencia de una sesión" style="text;html=1;fontStyle=1;fontSize=13;fontColor=#d79b00;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p3_a1" value="1. Instructor abre su&#xa;bloque de horarios para&#xa;una fecha concreta &amp;rarr;&#xa;el sistema calcula&#xa;fechaSesion real" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3_a2" value="2. Se trae la nómina&#xa;real desde ficha_usuario&#xa;(aprendices vinculados a&#xa;la ficha de ese horario)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="660" width="190" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3_a3" value="3. Instructor marca&#xa;estado por aprendiz&#xa;(presente/tardanza/&#xa;excusa/ausente) &amp;rarr;&#xa;upsert en asistencias" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="660" width="190" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3_a4" value="4. Si marca dos veces la&#xa;misma sesión: corrige la&#xa;fila existente (no&#xa;duplica) gracias al&#xa;UNIQUE constraint" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="660" width="190" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3_a5" value="5. Historial del aprendiz&#xa;cruza asistencias &amp;rarr;&#xa;horario para mostrar&#xa;tema/instructor/ambiente&#xa;de cada sesión" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1030" y="660" width="190" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3_aA" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="p3_a1" target="p3_a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_aB" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="p3_a2" target="p3_a3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_aC" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="p3_a3" target="p3_a4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_aD" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="p3_a4" target="p3_a5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_note" value="Nota: la tabla asistencias estuvo en el backlog sin endpoints porque el backend institucional&#xa;(Sofía Plus) no provee la nómina por ficha. Se activó usando la nómina que el sistema sí tiene:&#xa;ficha_usuario. Mientras esa nómina esté incompleta, la pantalla lo avisa en vez de fingir un curso entero." style="text;html=1;fontSize=10;fontStyle=2;align=left;fillColor=#f5f5f5;strokeColor=#999999;rounded=1;whiteSpace=wrap;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="1180" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
