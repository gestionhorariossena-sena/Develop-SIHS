  "item": [
    {
      "name": "Salud y contrato público",
      "item": [
        {
          "name": "Salud — 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/health",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.match(/application\\/json/i); });",
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Estado exacto\", function () { pm.expect(pm.response.json()).to.deep.eql({status: \"ok\"}); });"
                ]
              }
            }
          ]
        },
        {
          "name": "OpenAPI — 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/openapi.json",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.match(/application\\/json/i); });",
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"Rutas publicadas\", function () { pm.expect(body.openapi).to.be.a(\"string\"); pm.expect(body.paths).to.have.property(\"/api/v1/health\"); pm.expect(body.paths).to.have.property(\"/api/v1/programas/\"); });"
                ]
              }
            }
          ]
        },
