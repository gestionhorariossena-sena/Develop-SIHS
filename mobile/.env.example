# Plantilla del .env del cliente móvil. Copia este archivo a `mobile/.env`
# y completa los valores con los del MISMO proyecto Supabase que usan
# backend/.env y frontend/.env — los tres clientes comparten base de datos.

# Supabase Auth: el login del móvil va directo contra Supabase (igual que
# la web) y el backend valida ese JWT en app/core/supabase_auth.py.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key

# API del backend FastAPI. En emulador Android, AppConfig reescribe
# 127.0.0.1/localhost a 10.0.2.2 solo (ver lib/config/app_config.dart).
# En dispositivo físico usa la IP LAN del PC: http://192.168.x.x:8000/api/v1
API_BASE_URL=http://127.0.0.1:8000/api/v1
